package toolsite:app@0.1.0;

/// The app's own SQLite database. The host resolves which file this is from
/// the app's slug, so a guest can neither name another app's database nor
/// reach the filesystem to open one.
interface db {
    /// A SQLite value. Blobs are deliberately absent for now: nothing needs
    /// them yet, and adding a case later is backwards compatible.
    variant value {
        null,
        integer(s64),
        real(f64),
        text(string),
    }

    record rows {
        columns: list<string>,
        values: list<list<value>>,
        /// True when the result hit the host's row cap, so a guest can tell a
        /// short page from a truncated one.
        truncated: bool,
        rows-affected: u64,
    }

    variant error {
        /// The statement was rejected or failed.
        failed(string),
        /// The guest asked for something the host refuses outright, such as
        /// ATTACH.
        denied(string),
    }

    /// Runs one statement. Values are bound, never interpolated — there is no
    /// string-building entry point on purpose. Inside the SQL,
    /// `current_user()`, `current_email()` and `current_role()` answer for
    /// the signed-in visitor, or NULL when there is none.
    query: func(sql: string, params: list<value>) -> result<rows, error>;

    /// Runs one statement as the visitor, inside the app's declared access:
    /// the views named in toolsite.toml, read, and written only where a
    /// policy says `write = true`. Nothing else in the database is reachable,
    /// whatever the SQL says. For an app that lets its own users type SQL.
    query-scoped: func(sql: string, params: list<value>) -> result<rows, error>;

    /// One statement of a batch, with its parameters.
    record statement {
        sql: string,
        params: list<value>,
    }

    /// Runs `statements` in order, in one transaction: all of them take
    /// effect, or, if one fails, is refused or runs past the call's time,
    /// none do. Each is one statement, bound and answered as `query` would,
    /// with its own rows. A statement may not begin, commit or roll back a
    /// transaction of its own. The error names the failing statement,
    /// counting from zero.
    ///
    /// Added beside `query` rather than changing it, so a handler built
    /// before it links unchanged. There is no scoped batch: a person's SQL
    /// never holds a transaction open.
    batch: func(statements: list<statement>) -> result<list<rows>, error>;
}

/// Values the site's owner set for this app: API keys, endpoints, anything
/// that should not be in the bundle a visitor downloads.
///
/// Only this app's own settings are reachable, and only from inside a
/// handler. Nothing the platform serves ever returns a value — not the API,
/// not the source archive, not the admin page, which lists names alone.
interface secrets {
    /// The value set under `name`, or nothing if the owner never set one.
    get: func(name: string) -> option<string>;

    /// Which settings exist, so a handler can fail with something useful
    /// instead of silently behaving as though a key were empty.
    names: func() -> list<string>;
}

/// Live connections: WebSockets a browser holds open to the app, and TCP
/// connections and UDP remotes on the ports the site's owner mapped to it.
///
/// An app declares where its sockets live in toolsite.toml
/// (`[[socket]] path = "/live/ws"`, or `[[socket]] protocol = "tcp"` with a
/// `port`). Toolsite holds each socket and runs
/// the handler's `on-connection` export once per event, one at a time per
/// connection and in order: `connect`, then each `message`, then `close`.
/// The handler is the same component that answers requests, with the same
/// database, files, settings and identity; the person on the socket is
/// `identity.current-user()` for every event. A TCP or UDP connection has
/// no person: `remote` says where it comes from, and `auth.check-token`
/// decides whether the device may stay.
///
/// The functions here work from any call: a connection event, an ordinary
/// request or a scheduled job, so an API write can tell open sockets about
/// it. They only ever reach this app's own connections.
interface connections {
    /// One open connection. Unique among this app's connections, and never
    /// reused while the server runs.
    type connection-id = string;

    record connect-info {
        /// The declared socket path the browser connected to: "/live/ws".
        /// For a port, the protocol and port: "tcp:1883", "udp:5514".
        socket: string,
        /// The path inside the app, as a request would see it.
        path: string,
        query: string,
        /// The upgrade request's headers, without any x-toolsite-* header.
        headers: list<tuple<string, string>>,
    }

    variant message {
        text(string),
        binary(list<u8>),
    }

    variant event {
        /// A browser asks to connect. Return ok to accept it, or an error
        /// to refuse it; a refused browser gets HTTP 403 with that reason.
        /// A TCP connection or a UDP remote's first datagram arrives the
        /// same way, and a refused one is closed or dropped.
        connect(connect-info),
        /// A frame from the browser, at most 64 KB. From TCP, the bytes as
        /// they were read, in order, in chunks of at most 64 KB that need not
        /// follow the sender's writes. From UDP, one datagram.
        message(message),
        /// The connection ended, from either side. Its state is gone after.
        close,
    }

    /// Sends a message (at most 64 KB) to one connection.
    send: func(conn: connection-id, message: message) -> result<_, string>;
    /// Ends one connection. It still gets its `close` event.
    close: func(conn: connection-id) -> result<_, string>;
    /// Adds a connection to a topic. Topic names are lower-case letters,
    /// digits, '-' and '_', at most 64 characters, or `user:<id>`, which a
    /// connection may join only when it belongs to that account.
    subscribe: func(conn: connection-id, topic: string) -> result<_, string>;
    unsubscribe: func(conn: connection-id, topic: string) -> result<_, string>;
    /// Sends a message to every connection on a topic, and returns how
    /// many it reached. The app may publish to any `user:<id>` topic.
    publish: func(topic: string, message: message) -> result<u32, string>;
    /// A value kept for one connection between its events, so a handler
    /// needs no database for a session flag. At most 64 KB per connection;
    /// gone when the connection closes.
    state-get: func(conn: connection-id, key: string) -> option<string>;
    /// Sets a value, or removes it when `value` is none.
    state-set: func(conn: connection-id, key: string, value: option<string>) -> result<_, string>;
    /// Where a TCP connection or UDP remote comes from, as "ip:port". None
    /// for a WebSocket, and for a connection that is gone.
    remote: func(conn: connection-id) -> option<string>;
}

/// Tokens the site's owner minted for this app's devices (`tsv_...`), for a
/// TCP or UDP connection to present however its protocol carries one: a
/// first line, an MQTT password, a field in a datagram.
///
/// No gate stands in front of a port, since a device carries no cookie. The
/// app decides who stays, and this is how it checks.
interface auth {
    /// The token's label when it is a live device token of this app. None
    /// for anything else, another app's token included.
    check-token: func(token: string) -> option<string>;
}

/// Reaching other services, for the hosts this app was allowed to reach.
///
/// Off unless the app's toolsite.toml names them under allow_http. Even then
/// an address inside this server's own network is refused, whatever the name
/// resolved to — a URL fetcher on someone's private network is otherwise a
/// way to read the rest of it.
interface fetch {
    record request {
        method: string,
        url: string,
        headers: list<tuple<string, string>>,
        body: list<u8>,
    }

    record response {
        status: u16,
        headers: list<tuple<string, string>>,
        body: list<u8>,
    }

    /// The error is the reason, so a handler can tell "you did not ask for
    /// this host" from "that host is down".
    send: func(req: request) -> result<response, string>;
}

/// Who is making this request, as established by the host's session handling.
/// A guest cannot forge this: it is not derived from anything the client sent
/// except a session cookie the host verified.
interface identity {
    record user {
        id: string,
        email: string,
    }

    current-user: func() -> option<user>;

    /// What this account was granted on this app, if anything: "viewer",
    /// "editor", whatever the owner chose. Absent for a visitor with no
    /// grant, including on a public app.
    ///
    /// A separate function rather than a field on `user` on purpose: changing
    /// that record would stop every handler already published from linking.
    current-role: func() -> option<string>;
}

/// Files this app keeps: uploads, images, exports — anything too large or too
/// opaque for a row. One namespace per app, resolved by the host from the
/// slug exactly as the database is.
///
/// Bytes need not pass through the handler. To take a file from a browser,
/// hand it `upload-url` and let it PUT there; the platform stores the body
/// and a handler never holds it. To send one, answer with the header
/// `x-toolsite-blob: <key>` and an empty body; the platform streams the file
/// in its place, with the stored content type unless the response set one.
/// `get` is for things small enough to hold — anything over its ceiling is
/// refused, not truncated.
interface blobs {
    record entry {
        key: string,
        size: u64,
        /// What was given when it was stored. A listing does not carry
        /// this and says `application/octet-stream`; `stat` does.
        content-type: string,
    }

    record blob {
        content-type: string,
        body: list<u8>,
    }

    variant error {
        not-found,
        /// Keys are path segments of letters, digits, '-', '_' and '.',
        /// none empty and none starting with '.'.
        invalid-key(string),
        /// Bigger than the ceiling — `get`'s, or the platform's for a put.
        /// Carries the size.
        too-large(u64),
        failed(string),
    }

    put: func(key: string, content-type: string, body: list<u8>) -> result<_, error>;
    get: func(key: string) -> result<blob, error>;
    /// Size and type without the bytes. Absent means nothing is stored there.
    stat: func(key: string) -> result<option<entry>, error>;
    delete: func(key: string) -> result<_, error>;
    /// Everything under `prefix`, sorted by key, capped by the host. An empty
    /// prefix lists the app's whole namespace.
    %list: func(prefix: string) -> result<list<entry>, error>;
    /// A URL a browser may PUT one file to, once, within fifteen minutes,
    /// storing it under `key` with the request's content type. The URL is the
    /// credential: deciding who gets it is the handler's job. `max-bytes` of
    /// zero means the platform's own ceiling.
    upload-url: func(key: string, max-bytes: u64) -> result<string, error>;
}

/// What a request handler sees and returns. Deliberately small: enough to
/// route, read a body and answer.
interface http {
    record request {
        method: string,
        /// Path within the app, with the /p/<app> prefix already stripped.
        path: string,
        query: string,
        headers: list<tuple<string, string>>,
        body: list<u8>,
    }

    record response {
        status: u16,
        headers: list<tuple<string, string>>,
        body: list<u8>,
    }
}

/// What an app's handler.wasm must satisfy.
///
/// Note what is absent: no filesystem, no sockets and no environment. A
/// capability the host does not hand over is one the guest cannot exercise.
///
/// The wasi clocks are there: `std::time::SystemTime::now()` reads the wall
/// clock and `std::time::Instant` the monotonic one. The database has the
/// same time, `select cast(strftime('%s','now') as integer)`, which is the
/// clock every row is stamped with.
world app {
    use http.{request, response};

    import db;
    import blobs;
    import identity;
    import secrets;
    import fetch;
    import connections;
    import auth;

    export handle: func(req: request) -> response;
}

/// An app that also takes live connections. A component built for `app`
/// keeps working unchanged; one built for this world also gets each
/// connection event on its declared sockets.
world app-with-connections {
    include app;
    use connections.{connection-id, event};

    export on-connection: func(conn: connection-id, event: event) -> result<_, string>;
}

/// An app that runs resident (`[resident]` in toolsite.toml) and wants to
/// know when time passes, for keepalive timeouts and retries. A component
/// built for `app-with-connections` runs resident too; it only gets no
/// ticks.
///
/// `on-tick` is called every `tick_ms` on the resident instance, between
/// connection events and never at the same time as one. `now-ms` is the
/// wall clock in milliseconds since the Unix epoch.
world app-resident {
    include app-with-connections;

    export on-tick: func(now-ms: u64);
}
